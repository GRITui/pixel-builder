{
  "name": "pixel-builder",
  "version": "0.1.0",
  "description": "Turn realistic images into true pixel art (1 solid colour per pixel) at 8/16/32/64-bit era limits, with look presets. MCP + CLI for AI agents.",
  "bin": {
    "pixel-builder": "bin/pixel-builder.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "snake:assets": "tsx examples/snake/make-assets.ts",
    "cli": "tsx src/agent/cli.ts",
    "mcp": "tsx src/agent/cli.ts mcp",
    "snake:build": "tsx examples/snake/build.ts",
    "build:node": "esbuild src/agent/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist-node/cli.mjs",
    "check": "tsc && vitest run && npm run build:node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GRITui/pixel-builder.git"
  },
  "bugs": {
    "url": "https://github.com/GRITui/pixel-builder/issues"
  },
  "homepage": "https://github.com/GRITui/pixel-builder#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "dist-node",
    "skills",
    "AGENTS.md",
    "llms.txt"
  ]
}
