{
  "name": "pixel-builder",
  "version": "0.1.0",
  "description": "Vibe-code consistent pixel art: characters, buildings, maps, environments, objects and UI from one style kit.",
  "bin": {
    "pixel-builder": "bin/pixel-builder.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "cli": "tsx src/agent/cli.ts",
    "mcp": "tsx src/agent/cli.ts mcp",
    "build:node": "esbuild src/agent/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist-node/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GRITui/pixel-builder.git"
  },
  "bugs": {
    "url": "https://github.com/GRITui/pixel-builder/issues"
  },
  "homepage": "https://github.com/GRITui/pixel-builder#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "jpeg-js": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "dist-node",
    "dist",
    "skills",
    "AGENTS.md",
    "llms.txt",
    "docs/integrations.md"
  ]
}
