# Required only for AI features (Vibe / Freeform pixels). Procedural generators work without it.
ANTHROPIC_API_KEY=
# Optional overrides
# PIXEL_MODEL=claude-opus-5-5
# PORT=8787

# Alternative: any OpenAI-compatible endpoint (see docs/deploy.md)
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# AI_MODEL=qwen-max
# AI_VISION_MODEL=qwen-vl-max
